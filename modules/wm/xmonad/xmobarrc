Config {
    font = "JetBrainsMono Nerd Font Bold 10"
  , bgColor = "#010101"
  , fgColor = "#cdd6f4"
  , position = TopH 24
  , lowerOnStart = True
  , hideOnStart = False
  , allDesktops = True
  , overrideRedirect = True
  , persistent = True
  , commands = [
        Run Memory ["-t", "M: <used>/<total> GB"] 10
      , Run Date "%a, %b %d - %I:%M %p" "date" 10
      , Run UnsafeXMonadLog
    ]
  , sepChar = "%"
  , alignSep = "}{"
  , template = "%UnsafeXMonadLog% }{ <action=`fcitx5-configtool`><fc=#a6e3a1>󱇤</fc></action>  <fc=#b4befe>│</fc>  <action=`pavucontrol`><fc=#f5c2e7></fc></action>  <fc=#b4befe>│</fc>  <fc=#89b4fa>%memory%</fc>  <fc=#b4befe>│</fc>  <fc=#94e2d5>%date%</fc>           "
}
