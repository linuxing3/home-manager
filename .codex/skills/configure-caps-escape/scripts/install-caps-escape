#!/bin/sh
set -eu
action=${1:-install}
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
require_root() { [ "$(id -u)" -eq 0 ] || { echo "run install with sudo" >&2; exit 1; }; }
install_system() {
  require_root
  command -v loadkeys >/dev/null; command -v setxkbmap >/dev/null; command -v systemctl >/dev/null
  install -d -m 0755 /etc/kbd /etc/systemd/system /etc/xdg/autostart /etc/X11/Xsession.d /usr/local/bin
  install -m 0644 "$root/caps-escape.map" /etc/kbd/caps-escape.map
  loadkeys -b /etc/kbd/caps-escape.map >/dev/null
  symbols=/usr/share/X11/xkb/symbols/capslock
  if ! grep -q 'xkb_symbols "escape_shifted_capslock"' "$symbols"; then
    cp -p "$symbols" "$symbols.configure-caps-escape.bak"
    cat >> "$symbols" <<'EOF'

hidden partial modifier_keys
xkb_symbols "escape_shifted_capslock" {
    key <CAPS> {
        type[Group1] = "TWO_LEVEL",
        symbols[Group1] = [ Escape, Caps_Lock ],
        actions[Group1] = [ NoAction(), LockMods(modifiers = Lock) ]
    };
};
EOF
  fi
  for rules in /usr/share/X11/xkb/rules/base /usr/share/X11/xkb/rules/evdev; do
    if ! grep -q 'caps:escape_shifted_capslock' "$rules"; then
      cp -p "$rules" "$rules.configure-caps-escape.bak"
      sed -i '/caps:escape[[:space:]]*=[[:space:]]*+capslock(escape)$/a\  caps:escape_shifted_capslock = +capslock(escape_shifted_capslock)' "$rules"
    fi
  done
  if [ -f /etc/default/keyboard ] && ! grep -q 'caps:escape_shifted_capslock' /etc/default/keyboard; then
    cp -p /etc/default/keyboard /etc/default/keyboard.configure-caps-escape.bak
    sed -i 's/^XKBOPTIONS="\([^"]*\)"/XKBOPTIONS="\1caps:escape_shifted_capslock"/' /etc/default/keyboard
  fi
  install -m 0755 "$root/caps-escape-x11" /usr/local/bin/caps-escape-x11
  install -m 0644 "$root/caps-escape-x11.desktop" /etc/xdg/autostart/caps-escape-x11.desktop
  install -m 0755 "$root/80caps-escape" /etc/X11/Xsession.d/80caps-escape
  install -m 0644 "$root/caps-escape.service" /etc/systemd/system/caps-escape.service
  systemctl daemon-reload; systemctl enable --now caps-escape.service
}
activate() { [ -n "${DISPLAY:-}" ] || { echo "no X11 DISPLAY" >&2; exit 1; }; setxkbmap -option caps:escape_shifted_capslock; }
verify() { loadkeys -b /etc/kbd/caps-escape.map >/dev/null; systemctl is-enabled caps-escape.service; systemctl is-active caps-escape.service; }
case "$action" in install) install_system ;; activate) activate ;; verify) verify ;; *) echo "usage: $0 [install|activate|verify]" >&2; exit 2 ;; esac
