#!/bin/sh
set -eu

action=${1:-install}
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

require_root() {
  [ "$(id -u)" -eq 0 ] || {
    echo "run install with sudo" >&2
    exit 1
  }
}

install_system() {
  require_root
  command -v keyd >/dev/null
  command -v systemctl >/dev/null

  install -d -m 0755 /etc/keyd
  install -m 0644 "$root/keyd-default.conf" /etc/keyd/default.conf

  keyd check /etc/keyd/default.conf >/dev/null
  systemctl daemon-reload
  systemctl enable --now keyd.service
}

activate() {
  require_root
  systemctl restart keyd.service
}

verify() {
  keyd check /etc/keyd/default.conf >/dev/null
  systemctl is-enabled keyd.service
  systemctl is-active keyd.service
}

case "$action" in
  install) install_system ;;
  activate) activate ;;
  verify) verify ;;
  *)
    echo "usage: $0 [install|activate|verify]" >&2
    exit 2
    ;;
esac
