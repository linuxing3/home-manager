#!/usr/bin/env bash
set -euo pipefail

names_file=${1:-}
apply=false
if [[ ${2:-} == "--apply" ]]; then apply=true; elif [[ $# -gt 1 ]]; then printf 'usage: %s names-file [--apply]\n' "$0" >&2; exit 2; fi
[[ -f "$names_file" ]] || { printf 'names file not found\n' >&2; exit 1; }

atuin_bin=${ATUIN_BIN:-}
if [[ -z "$atuin_bin" ]]; then
  if command -v atuin >/dev/null 2>&1; then atuin_bin=$(command -v atuin)
  elif [[ -x "$HOME/.nix-profile/bin/atuin" ]]; then atuin_bin="$HOME/.nix-profile/bin/atuin"
  else printf 'atuin executable not found\n' >&2; exit 1; fi
fi

count=0
while IFS= read -r name || [[ -n "$name" ]]; do
  [[ -z "$name" || "$name" =~ ^[[:space:]]*# ]] && continue
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { printf 'invalid variable name\n' >&2; exit 1; }
  count=$((count + 1))
  if [[ "$apply" == true ]]; then "$atuin_bin" dotfiles var delete "$name" >/dev/null; fi
done < "$names_file"

"$atuin_bin" dotfiles var list >/dev/null
printf 'reviewed=%d applied=%s\n' "$count" "$apply"
